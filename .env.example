VITE_API_BASE_URL=http://localhost:8000/api
# Keep this file public. Put real values only in a local .env file.
JWT_SECRET=replace-with-a-long-random-value
DATABASE_URL=sqlite:///./travel_copilot.db
USE_DEMO_DATA=false

# Required for real Amadeus flight-offer search (test or production credentials).
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_ENVIRONMENT=test

# Optional image provider key. Wikimedia Commons is used without a key by default.
UNSPLASH_ACCESS_KEY=
# Open-Meteo is used without a key by default; reserved for another weather provider.
WEATHER_API_KEY=
# Configure the adapter for your contracted live hotel inventory provider.
HOTEL_PROVIDER_API_KEY=
